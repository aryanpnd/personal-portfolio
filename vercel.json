{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        },
        {
            "src": "portfolio-frontend-v1/dist/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/index.js"
        },
        {
            "src": "/(.*\\.(js|css|svg|png|jpg|jpeg|gif|ico|json|pdf))",
            "dest": "/portfolio-frontend-v1/dist/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/portfolio-frontend-v1/dist/index.html"
        }
    ]
}